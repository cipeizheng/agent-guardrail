# Copy to .env. Do not commit real values.
AGENT_GUARDRAIL_CORE_API_KEY=replace-with-a-long-random-core-service-key
AGENT_GUARDRAIL_GATEWAY_API_KEYS=["replace-with-a-client-key"]
AGENT_GUARDRAIL_UPSTREAM_BASE_URL=https://api.openai.com/v1
AGENT_GUARDRAIL_UPSTREAM_API_KEY=replace-with-provider-key
AGENT_GUARDRAIL_UPSTREAM_ALLOWED_HOSTS=["api.openai.com"]

# Optional overrides
AGENT_GUARDRAIL_POLICY_FILE=./examples/policies/secret-email.yaml
AGENT_GUARDRAIL_GATEWAY_PORT=8080
AGENT_GUARDRAIL_CORE_PROMPT_MODEL_DEVICE=cpu
